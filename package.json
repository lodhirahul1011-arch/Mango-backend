{
  "name": "mango-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node backend-integration/server.cjs",
    "start": "node backend-integration/server.cjs",
    "test": "node --test backend-integration/app.test.cjs backend-integration/pio/contact.test.cjs",
    "start:roomrent": "node --env-file-if-exists=.env src/server.js",
    "test:roomrent": "node --test test/*.test.js",
    "build": "node --check backend-integration/server.cjs",
    "mail:verify": "node backend-integration/pio/verify.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "nodemailer": "^6.9.7"
  }
}

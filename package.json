{
  "name": "mango-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "node backend-integration/server.cjs",
    "test": "node --test backend-integration/app.test.cjs backend-integration/pio/contact.test.cjs backend-integration/netlify.test.cjs",
    "start:roomrent": "node --env-file-if-exists=.env src/server.js",
    "test:roomrent": "node --test test/*.test.js",
    "build": "npm --prefix frontend ci && npm --prefix frontend run build && node --check netlify/functions/api.cjs",
    "mail:verify": "node backend-integration/pio/verify.cjs",
    "dev:api": "node backend-integration/server.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "nodemailer": "^6.9.7",
    "serverless-http": "^4.0.0"
  }
}
